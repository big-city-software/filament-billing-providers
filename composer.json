{
    "name": "big-city-software/filament-billing-providers",
    "description": "Filament tenant billing providers for Polar, Paddle Billing, and Lemon Squeezy. Checkout is a configured URL redirect. Verified webhooks upsert a local subscription row that the tenant gate reads.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "billing",
        "polar",
        "paddle",
        "lemon-squeezy",
        "tenancy",
        "subscription"
    ],
    "homepage": "https://github.com/big-city-software/filament-billing-providers",
    "support": {
        "issues": "https://github.com/big-city-software/filament-billing-providers/issues",
        "source": "https://github.com/big-city-software/filament-billing-providers"
    },
    "authors": [
        {
            "name": "Segment Holdings LLC",
            "email": "hello@segment.holdings"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.15 || ^5.10",
        "illuminate/support": "^12.69 || ^13.30"
    },
    "require-dev": {
        "orchestra/testbench": "^10.12 || ^11.3",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SegmentHoldings\\FilamentBillingProviders\\": "src/"
        },
        "files": [
            "src/Compatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SegmentHoldings\\FilamentBillingProviders\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SegmentHoldings\\FilamentBillingProviders\\FilamentBillingProvidersServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
